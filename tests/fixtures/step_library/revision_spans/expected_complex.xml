	<text ana="hc:Article">
		<body>
			<!-- 1 -->
			<pb facs="#A1_1r"/>
			<cb facs="#A1_1r-a"/>
			<head>
            <lb n="1"/>Wanderers Nachtlied <delSpan rendition="hc:Strikethrough" spanTo="#delSpan_1"/><del ana="hc:EditorialDeletionSpan" hei:belongsToRevision="#delSpan_1">eigenhändig aufgezeichnet</del></head>
			<l ana="hc:EditorialDeletionSpan"><lb n="2"/>Über allen Gipfeln ist Ruh</l>
			<l ana="hc:EditorialDeletionSpan"><lb n="3"/>In allen Wipfeln spürest du</l>
			<l><del ana="hc:EditorialDeletionSpan" hei:belongsToRevision="#delSpan_1">Kaum</del><lb n="4"/><del ana="hc:EditorialDeletionSpan" hei:belongsToRevision="#delSpan_1">einen </del><persName><w ana="hc:EditorialDeletionSpan">Wolfgang</w> <w><del ana="hc:EditorialDeletionSpan" hei:belongsToRevision="#delSpan_1">Goe</del><anchor xml:id="delSpan_1"/>the</w></persName> Hauch</l>
			<l><lb n="5"/>Die Vögelein schweigen im Walde.</l>
			
			<!-- 2 -->
			<lg>
				<lb n="6"/>
				<addSpan spanTo="#addSpan_1"/>
				<l ana="hc:EditorialAdditionSpan">Der du von dem Himmel bist, </l>
				<lb n="7"/><l ana="hc:EditorialAdditionSpan">Alles Leid und Schmerzen stillest,</l>
			</lg>
			<lg ana="hc:EditorialAdditionSpan">
				<lb n="8"/><l>Den, der doppelt elend ist,</l>
				<lb n="9"/><l>Doppelt mit Erquickung füllest,</l>
			</lg>
			<lg>
				<lb n="10"/><l><add ana="hc:EditorialAdditionSpan" hei:belongsToRevision="#addSpan_1">Ach, ich bin des</add><anchor xml:id="addSpan_1"/> Treibens müde!</l>
				<lb n="11"/><l>Was soll all der Schmerz und Lust?</l>
				<lb n="12"/><l>Süßer Friede,</l>
				<lb n="13"/><l>Komm, ach komm in meine Brust!</l>
			</lg>
			
			<!-- 3 -->
			<pb facs="#A1_1v"/>
			<cb facs="#A1_1v-a"/>
			<lg>
				<lb n="1"/><l>Der du von dem Himmel bist, </l>
				<addSpan spanTo="#addSpan_3"/>
				<lb n="2"/><l ana="hc:EditorialAdditionSpan">Alles <hi rendition="hc:Bold">Leid und Schmerzen stillest,</hi></l>
			</lg>
			<lg ana="hc:EditorialAdditionSpan">
				<l>Den, der <lb n="3"/>doppelt elend ist,</l>
				<l>Doppelt mit <lb n="4"/>Erquickung füllest,</l>
			</lg>
			<lg>
				<lb n="5"/><l><hi ana="hc:EditorialAdditionSpan">A</hi><add ana="hc:EditorialAdditionSpan" hei:belongsToRevision="#addSpan_3">ch, ich </add><hi rendition="hc:Bold"><add ana="hc:EditorialAdditionSpan" hei:belongsToRevision="#addSpan_3">bin des</add><anchor xml:id="addSpan_3"/> Treibens</hi> müde!</l>
				<lb n="6"/><l>Was soll all der Schmerz und Lust?</l>
				<lb n="7"/><l>Süßer Friede,</l>
				<lb n="8"/><l>Komm, ach komm in meine Brust!</l>
			</lg>
			
