				<l ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_3"><add ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_3">Den, der </add><lb n="3"/><add ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_3">doppelt elend ist,</add></l>
				<l ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_3"><add ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_3">Doppelt mit </add><lb n="4"/><add ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_3">Erquickung füllest,</add></l>
			</lg>
