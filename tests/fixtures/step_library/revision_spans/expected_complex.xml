	<text ana="hc:Article">
		<body>
			<!-- 1 -->
			<pb facs="#A1_1r"/>
			<cb facs="#A1_1r-a"/>
			<head>
            <lb n="1"/>Wanderers Nachtlied <delSpan rendition="hc:Strikethrough" spanTo="#delSpan_1"/><del ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1">eigenhändig aufgezeichnet</del></head>
			<l ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1"><lb n="2"/><del ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1">Über allen Gipfeln ist Ruh</del></l>
			<l ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1"><lb n="3"/><del ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1">In allen Wipfeln spürest du</del></l>
			<l ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1"><del ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1">Kaum</del><lb n="4"/><del ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1">einen </del><persName ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1"><w ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1">Wolfgang</w> <w ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1"><del ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1">Goe</del><anchor xml:id="delSpan_1"/>the</w></persName><del ana="hc:InDeletionSpan" hei:belongsToRevision="#delSpan_1"> Hauch</del></l>
			<l><lb n="5"/>Die Vögelein schweigen im Walde.</l>
			
			<!-- 2 -->
			<lg>
				<lb n="6"/>
				<addSpan spanTo="#addSpan_1"/>
				<l ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1"><add ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1">Der du von dem Himmel bist, </add></l>
				<lb n="7"/><l ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1"><add ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1">Alles Leid und Schmerzen stillest,</add></l>
			</lg>
			<lg ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1">
				<lb n="8"/><l ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1"><add ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1">Den, der doppelt elend ist,</add></l>
				<lb n="9"/><l ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1"><add ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1">Doppelt mit Erquickung füllest,</add></l>
			</lg>
			<lg ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1">
				<lb n="10"/><l ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1"><add ana="hc:InAdditionSpan" hei:belongsToRevision="#addSpan_1">Ach, ich bin des</add><anchor xml:id="addSpan_1"/> Treibens müde!</l>
				<lb n="11"/><l>Was soll all der Schmerz und Lust?</l>
				<lb n="12"/><l>Süßer Friede,</l>
				<lb n="13"/><l>Komm, ach komm in meine Brust!</l>
			</lg>
			
