	<text ana="hc:Article">
		<body>
			<!-- 1 -->
			<pb facs="#A1_1r"/>
			<cb facs="#A1_1r-a"/>
			<head>
            <lb n="1"/>Wanderers Nachtlied <delSpan rendition="hc:Strikethrough" spanTo="#delSpan_1"/>eigenhändig aufgezeichnet</head>
			<l><lb n="2"/>Über allen Gipfeln ist Ruh</l>
			<l><lb n="3"/>In allen Wipfeln spürest du</l>
			<l>Kaum<lb n="4"/>einen <persName><w>Wolfgang</w> <w>Goe<anchor xml:id="delSpan_1"/>the</w></persName> Hauch</l>
			<l><lb n="5"/>Die Vögelein schweigen im Walde.</l>
			
			<!-- 2 -->
			<lg>
				<lb n="6"/>
				<addSpan spanTo="#addSpan_1"/>
				<l>Der du von dem Himmel bist, </l>
				<lb n="7"/><l>Alles Leid und Schmerzen stillest,</l>
			</lg>
			<lg>
				<lb n="8"/><l>Den, der doppelt elend ist,</l>
				<lb n="9"/><l>Doppelt mit Erquickung füllest,</l>
			</lg>
			<lg>
				<lb n="10"/><l>Ach, ich bin des<anchor xml:id="addSpan_1"/> Treibens müde!</l>
				<lb n="11"/><l>Was soll all der Schmerz und Lust?</l>
				<lb n="12"/><l>Süßer Friede,</l>
				<lb n="13"/><l>Komm, ach komm in meine Brust!</l>
			</lg>
			
			<!-- 3 -->
			<pb facs="#A1_1v"/>
			<cb facs="#A1_1v-a"/>
			<lg>
				<lb n="1"/><l>Der du von dem Himmel bist, </l>
