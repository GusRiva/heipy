			</lg>
			<lg>
				<l>Den, der <lb n="3"/>doppelt elend ist,</l>
				<l>Doppelt mit <lb n="4"/>Erquickung füllest,</l>
			</lg>
			<lg>
				<lb n="5"/><l><hi>A</hi>ch, ich <hi rendition="hc:Bold">bin des<anchor xml:id="addSpan_3"/> Treibens</hi> müde!</l>
				<lb n="6"/><l>Was soll all der Schmerz und Lust?</l>
				<lb n="7"/><l>Süßer Friede,</l>
				<lb n="8"/><l>Komm, ach komm in meine Brust!</l>
			</lg>
			
			<!-- 4 -->
			<lg>
				<lb n="9"/><l>Der du von dem Himmel bist, </l>
				<lb n="10"/><l>Alles <delSpan spanTo="#delSpan_4"/><hi rendition="hc:Bold">Leid und Schmerzen stillest,</hi></l>
			</lg>
			<lg>
				<lb n="11"/><l>Den, der doppelt elend ist,</l>
				<lb n="12"/><l>Doppelt mit Erquickung füllest,</l>
			</lg>
			<lg>
